DATABASE_URL="file:./dev.db"

AI_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
AI_API_KEY="<your-api-key>"
AI_MODEL="<your-endpoint-id-or-model-id>"
AI_USER="<your-challenge-email>"

# Optional aliases for official Ark resource-pool configuration.
# Do not commit real keys or endpoint IDs.
ARK_API_KEY=""
ARK_MODEL=""
ARK_ENDPOINT_ID=""
ARK_BASE_URL=""
ARK_USER=""

SESSION_SECRET="replace-with-a-long-random-secret"
VERIFICATION_CODE_SECRET="replace-with-a-different-long-random-secret"
REVIEW_TOKEN_SECRET="replace-with-a-review-token-secret"
APP_URL="http://localhost:3000"
SMS_DELIVERY_MODE="mock"

# Volcengine SMS verification. When all fields are present, phone login uses
# SendSmsVerifyCode / CheckSmsVerifyCode instead of the local mock code.
VOLC_ACCESSKEY=""
VOLC_SECRETKEY=""
VOLC_SMS_ACCOUNT=""
VOLC_SMS_SIGN=""
VOLC_SMS_TEMPLATE_ID=""
VOLC_SMS_REGION="cn-north-1"
VOLC_SMS_SCENE="auth"
VOLC_SMS_TAG="auth"
VOLC_SMS_CODE_TYPE="6"
VOLC_SMS_EXPIRE_SECONDS="300"
VOLC_SMS_TRY_COUNT="5"

# Volc mail SMTP channel. When all fields are present, registration email codes
# are sent by SMTP; otherwise local development shows a debug code.
VOLC_EMAIL_SMTP_HOST=""
VOLC_EMAIL_SMTP_PORT="465"
VOLC_EMAIL_SMTP_SECURE="true"
VOLC_EMAIL_SMTP_USER=""
VOLC_EMAIL_SMTP_PASS=""
VOLC_EMAIL_FROM=""
